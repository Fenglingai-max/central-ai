# Public Web OAuth Client ID only. A Client Secret is not used by this GIS flow.
GOOGLE_CLIENT_ID=
PORT=3000
HOST=127.0.0.1
# Keep true for each user running their own local ChatGPT plan.
# A public Google-only server must explicitly set false; it cannot expose local ChatGPT.
CENTRAL_LOCAL_CHATGPT_ENABLED=true
# API/server origin; do not add a URL path.
CENTRAL_PUBLIC_ORIGIN=http://localhost:3000
# Optional Google-only deployment origins, comma separated; never use '*'.
# Local ChatGPT mode always requires the same loopback origin and ignores remote access.
CENTRAL_ALLOWED_ORIGINS=
# Local loopback development only. Never true on a public or production deployment.
CENTRAL_DEV_INSECURE_COOKIES=true
NODE_ENV=development
